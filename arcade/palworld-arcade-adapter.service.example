[Unit]
Description=arcade.stanley.arpa control adapter for docker-palworld
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
User=jake
WorkingDirectory=/home/jake/git/github.com/jakestanley/docker-palworld
ExecStart=/usr/bin/python3 /home/jake/git/github.com/jakestanley/docker-palworld/arcade/adapter.py
Restart=on-failure
RestartSec=5

# Overrides — copy this file to /etc/systemd/system/palworld-arcade-adapter.service,
# adjust User/WorkingDirectory/paths for your host, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now palworld-arcade-adapter
Environment=ARCADE_SERVER_ID=palworld
Environment=ARCADE_SERVER_NAME=Palworld
Environment=ARCADE_BASE_URL=http://arcade.stanley.arpa
Environment=ARCADE_ADAPTER_PORT=8300
Environment=ARCADE_HEARTBEAT_SECONDS=30

[Install]
WantedBy=multi-user.target

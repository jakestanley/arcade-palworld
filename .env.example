# Path to your Palworld server data directory
DATA_PATH=./data

# Where automatic/manual backups are written. Mounted as a second, narrower
# bind mount over the image's own fixed internal backup path
# (/palworld/backups) -- separate from DATA_PATH so backups can live
# somewhere else (e.g. synced to cloud storage) without moving world saves.
BACKUP_PATH=/var/media/Dropbox/backups/Palworld

# thijsvanloef/palworld-server-docker image tag — check https://github.com/thijsvanloef/palworld-server-docker/pkgs/container/palworld-server-docker
PALWORLD_TAG=latest

# UID/GID to run the server process as (avoids permission issues on the data volume)
PUID=1000
PGID=1000

# Timezone for logs/backups
TZ=Etc/UTC

# Port to expose the game server on (UDP)
SERVER_PORT=8211

# Server name and description shown in the in-game server browser
SERVER_NAME=Jake's Palworld Server
SERVER_DESCRIPTION=

# Password required to join (leave blank for none)
SERVER_PASSWORD=

# Admin password — required to use in-game admin commands
ADMIN_PASSWORD=changeme

# Max concurrent players
PLAYERS=16

# Max pals that can be assigned to work at a single base (in-game default/cap
# via the UI is 15 — this raises the actual server-enforced limit)
BASE_CAMP_WORKER_MAX_NUM=15

# Improves performance on multi-core hosts (replaces deprecated MULTITHREADING)
ENABLE_PERF_THREADING_ARGS=true
# Number of server worker threads — set to your host's core count
WORKER_THREADS_SERVER=4

# List the server publicly in the in-game "Community" browser
COMMUNITY=false

# Which platforms may crossplay-connect, parenthesized comma-separated list
# (Steam, Xbox, PS5, Mac — no spaces). Must include Xbox for Game Pass/
# Microsoft Store players to join. Replaces deprecated ALLOW_CONNECT_PLATFORM.
CROSSPLAY_PLATFORMS=(Steam,Xbox)

# RCON (remote console) — enable if you want external tools to manage the server
RCON_ENABLED=false
RCON_PORT=25575

# Automatically apply Palworld server updates on container start
AUTO_UPDATE_ENABLED=true
UPDATE_ON_BOOT=true

# Automatic save backups
BACKUP_ENABLED=true
BACKUP_CRON_EXPRESSION=0 */6 * * *
DELETE_OLD_BACKUPS=true
OLD_BACKUP_DAYS=7

# Any additional PalWorldSettings.ini values (difficulty, rates, PvP, etc.) can be
# passed as extra environment variables — see the full list at:
# https://github.com/thijsvanloef/palworld-server-docker#environment-variables

# arcade.stanley.arpa control adapter (arcade/) — registers this server for
# start/stop from the shared arcade portal. See arcade/README.md.
# ARCADE_ADAPTER_BASE_URL is REQUIRED (not optional): the adapter runs in
# Docker's bridge network, so it can only ever detect its own private
# container IP, never the host's. Prefer the host's *.stanley.arpa DNS
# name (survives the host's IP ever changing) over a raw IP if one exists
# in homelab-infra/edge's dnsmasq config — e.g. adler.stanley.arpa.
ARCADE_ADAPTER_BASE_URL=http://<host>.stanley.arpa:8300

# Defaults shown are fine for a single-instance deployment; override only if
# running more than one Palworld server on the same arcade portal.
# ARCADE_SERVER_ID=arcade-palworld
# ARCADE_SERVER_NAME=Palworld
# ARCADE_SERVER_DESCRIPTION=Palworld dedicated server (arcade-palworld)
# ARCADE_BASE_URL=https://arcade.stanley.arpa
# ARCADE_ADAPTER_PORT=8300
# ARCADE_HEARTBEAT_SECONDS=30

# UPnP port-forwarding: the adapter opens SERVER_PORT/udp on the router when
# the server starts and closes it when it stops (reuses SERVER_PORT above —
# no separate value to keep in sync). RCON is never forwarded. Requires the
# router to have UPnP enabled. Set to false if UPnP misbehaves on your router
# and you'd rather forward the port manually as before.
# ARCADE_UPNP_ENABLED=true
# ARCADE_FORWARD_PROTOCOL=udp
